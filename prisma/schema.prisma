// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One Patient is an archiveable case; no real patient information in seed data.
enum Payer {
  Aetna
  Cigna
  Cigna_ASH
  BCBS
  UHC
  other
}

enum NoteStatus {
  draft
  finalized
}

enum NoteKind {
  initial
  follow_up
  re_evaluation
  addendum
}

enum AppointmentStatus {
  scheduled
  completed
  cancelled
  no_show
}

model Patient {
  id                   String      @id @default(cuid())
  identifier           String      @unique
  payer                Payer
  primaryTreatmentArea String
  caseOpenedDate       String // YYYY-MM-DD clinic calendar date, never timezone shifted
  archivedAt           DateTime?
  isDemo               Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  encounters           Encounter[]
  visits               Visit[]
  appointments         Appointment[]
}

// Square appointments are a schedule reference; they are not treatment records.
model Appointment {
  id                 String            @id
  squareAppointmentId String           @unique
  patientId          String?
  patient            Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  scheduledAt        String
  status             AppointmentStatus
  isDemo             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([scheduledAt])
}

// One actual treatment encounter; note revisions never increase treatment count.
model Encounter {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  visits    Visit[]

  @@unique([id, patientId])
  @@index([patientId])
}

// Every saved note revision is a new row. date stores the actual service date.
model Visit {
  id               String     @id @default(cuid())
  patientId        String
  patient          Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounterId      String
  encounter        Encounter  @relation(fields: [encounterId, patientId], references: [id, patientId], onDelete: Restrict)
  version          Int        @default(1)
  date             String // YYYY-MM-DD actual clinic service date
  kind             NoteKind   @default(follow_up)
  painScore        Int?
  romData          Json       @default("{}")
  treatmentAreas   Json       @default("[]")
  cptCodes         Json       @default("[]")
  narrativeDelta   String
  generatedNote    String
  status           NoteStatus @default(draft)
  payerFlags       Json       @default("[]")
  finalizedAt      DateTime?
  addendumToId     String?
  addendumTo       Visit?     @relation("Addenda", fields: [addendumToId], references: [id], onDelete: Restrict)
  addenda          Visit[]    @relation("Addenda")
  correctionReason String?
  createdAt        DateTime   @default(now())

  @@unique([encounterId, version])
  @@index([patientId, date])
}
